# ============================================================
# GREEN NARODA • CLEAN NARODA — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
#
# Usage:
#   cp .env.example .env
#   nano .env   # Fill in values
# ============================================================

# ─── Django ───────────────────────────────────────────────────────────────────

# Generate a strong secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# development | production
DJANGO_SETTINGS_MODULE=config.settings.development

DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,mynaroda.in,www.mynaroda.in

# Comma-separated list of trusted CSRF origins
CSRF_TRUSTED_ORIGINS=https://mynaroda.in,https://www.mynaroda.in

# Comma-separated CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000


# ─── Database (PostgreSQL) ────────────────────────────────────────────────────

DB_NAME=mynaroda_dev
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432


# ─── Redis ────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0


# ─── Email (SMTP) ─────────────────────────────────────────────────────────────

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=Green Naroda <noreply@mynaroda.in>


# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Sign up at https://cloudinary.com and get your credentials

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret


# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret


# ─── Error Monitoring (Sentry) ────────────────────────────────────────────────
# Leave blank to disable

SENTRY_DSN=


# ─── Site Configuration ───────────────────────────────────────────────────────

SITE_URL=http://localhost:8000
SITE_NAME=Green Naroda
